# Sao chép thành backend/.env. KHÔNG commit .env.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB — local (database/docker-compose.yml) hoặc chuỗi kết nối Atlas
MONGODB_URI=mongodb://localhost:27017/webkhupho

# JWT access token — chuỗi ngẫu nhiên ≥ 32 ký tự.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_MINUTES=15

# Refresh token (cookie httpOnly), số ngày hết hạn nếu không dùng
REFRESH_TOKEN_TTL_DAYS=7
# true khi chạy HTTPS (bắt buộc ở production)
COOKIE_SECURE=false

# Origin frontend được phép gọi API, phân cách bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173

# Khoá tài khoản khi đăng nhập sai liên tiếp
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Mật khẩu cho tài khoản mẫu khi chạy `npm run seed:users` (bỏ trống = tự sinh và in ra)
SEED_ADMIN_PASSWORD=
SEED_OFFICER_PASSWORD=
SEED_CITIZEN_PASSWORD=
