# =====================================================================
#  WEBKHUPHO — MẪU cấu hình. Sao chép thành .env (cùng thư mục) rồi điền.
#    cp .env.example .env
#  Backend và frontend đều đọc .env ở thư mục gốc. KHÔNG commit .env.
# =====================================================================


# ---------------------------------------------------------------------
# 1. DATABASE — MongoDB
# ---------------------------------------------------------------------
# Docker local (cd database && docker compose up -d):
MONGODB_URI=mongodb://localhost:27017/webkhupho
# Hoặc MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/webkhupho?retryWrites=true&w=majority


# ---------------------------------------------------------------------
# 2. BACKEND — server, bảo mật, đăng nhập
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Bắt buộc: chuỗi ngẫu nhiên ≥ 32 ký tự. Tạo nhanh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# false khi chạy http://localhost; production (HTTPS) phải là true
COOKIE_SECURE=false

# Frontend nào được gọi API (phân cách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173

# Sai mật khẩu bao nhiêu lần thì khoá tạm, khoá bao nhiêu phút
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15


# ---------------------------------------------------------------------
# 3. FRONTEND — chỉ biến có tiền tố VITE_ mới vào code trình duyệt
# ---------------------------------------------------------------------
VITE_APP_NAME=Quản lý dân cư
VITE_API_BASE_URL=/api
# true = các trang nhân khẩu / hộ / tạm trú dùng dữ liệu mẫu
VITE_USE_MOCK=true
# Đăng nhập:  api  = qua backend thật (cần MongoDB + backend đang chạy)
#             demo = tài khoản mẫu ngay trên trình duyệt (src/mocks/demoAuth.ts), không cần backend.
#                    Mật khẩu demo ai cũng đọc được trong JS → KHÔNG dùng với dữ liệu thật.
VITE_AUTH_MODE=api


# ---------------------------------------------------------------------
# 4. ĐĂNG NHẬP TẠM THỜI — tài khoản mẫu (npm run seed:users trong backend/)
# ---------------------------------------------------------------------
#   Vai trò       Tên đăng nhập     Mật khẩu
#   Quản trị      admin             SEED_ADMIN_PASSWORD
#   Cán bộ        canbo01           SEED_OFFICER_PASSWORD
#   Người dân     001099012345      SEED_CITIZEN_PASSWORD
# Mật khẩu: ≥ 8 ký tự, có chữ và số. Bỏ trống = tự sinh ngẫu nhiên và in ra một lần.
SEED_ADMIN_PASSWORD=
SEED_OFFICER_PASSWORD=
SEED_CITIZEN_PASSWORD=
