# =====================================================================
#  WEBKHUPHO — MẪU cấu hình. Sao chép thành .env (cùng thư mục) rồi điền.
#    cp .env.example .env
#  Backend và frontend đều đọc .env ở thư mục gốc. KHÔNG commit .env.
# =====================================================================


# ---------------------------------------------------------------------
# 1. DATABASE — MongoDB
# ---------------------------------------------------------------------
# Docker local (cd database && docker compose up -d):
MONGODB_URI=mongodb://localhost:27017/webkhupho
# Hoặc MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/webkhupho?retryWrites=true&w=majority
# Tên database của hệ thống (ghi đè tên DB trong URI). Bỏ trống = khupho.
MONGODB_DB_NAME=khupho
# Chờ kết nối tối đa bao lâu (ms). Mạng chậm / Atlas ở xa → tăng lên.
MONGODB_TIMEOUT_MS=30000


# ---------------------------------------------------------------------
# 2. BACKEND — server, bảo mật, đăng nhập
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Bắt buộc: chuỗi ngẫu nhiên ≥ 32 ký tự. Tạo nhanh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# false khi chạy http://localhost; production (HTTPS) phải là true
COOKIE_SECURE=false

# Bắt buộc: mã hoá dữ liệu cá nhân (họ tên, CCCD, SĐT, email…).
# MẤT KHOÁ = KHÔNG ĐỌC LẠI ĐƯỢC DỮ LIỆU — sao lưu an toàn, không commit.
#   DATA_ENCRYPTION_KEY (32 byte base64): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   DATA_INDEX_KEY (≥ 32 ký tự, khác khoá trên): node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
DATA_ENCRYPTION_KEY=
DATA_INDEX_KEY=

# Frontend nào được gọi API (phân cách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173
# Sau proxy (Cloudflare, Vercel rewrite…): số proxy phía trước để lấy IP thật. Bỏ trống khi chạy trực tiếp ở máy.
# Cloudflare (Tunnel / proxy): IP thật nằm trong header này. Đặt cf-connecting-ip khi chạy sau Cloudflare.
CLIENT_IP_HEADER=
TRUST_PROXY=

# Sai mật khẩu bao nhiêu lần thì khoá tạm, khoá bao nhiêu phút
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Giới hạn mỗi IP / 15 phút: đăng nhập, xin mật khẩu tạm
LOGIN_RATE_LIMIT=20
TEMP_PASSWORD_RATE_LIMIT=5
# Chống spam (mỗi IP): mọi API / phút, API ghi dữ liệu / phút; số phiên đăng nhập tối đa mỗi tài khoản
API_RATE_LIMIT=300
WRITE_RATE_LIMIT=30
MAX_SESSIONS_PER_USER=10
# Chống quá tải: kết nối HTTP đồng thời, thời gian tối đa mỗi request (ms), số kết nối tới MongoDB
HTTP_MAX_CONNECTIONS=1000
HTTP_REQUEST_TIMEOUT_MS=30000
MONGODB_MAX_POOL_SIZE=20
# Độ khó băm mật khẩu bcrypt (10–14)
BCRYPT_COST=12

# Mật khẩu tạm qua SMS (đăng nhập lần đầu / quên mật khẩu)
# mock = chưa gửi SMS thật: mật khẩu tạm ghi ra log backend và hiện trên màn hình đăng nhập (trừ production)
SMS_PROVIDER=mock
TEMP_PASSWORD_TTL_MINUTES=15
TEMP_PASSWORD_RESEND_SECONDS=60

# Firebase — xác minh SĐT bằng OTP SMS (Firebase Console › Project settings › General).
# Backend chỉ cần mã project để kiểm tra ID token; bỏ trống = tắt POST /api/auth/firebase-login.
FIREBASE_PROJECT_ID=

# Thu quỹ — tài khoản nhận mặc định để tạo mã VietQR (quỹ chưa có tài khoản riêng). Đặt đủ cả 3 hoặc bỏ trống.
# BIN theo VietQR: 970436 Vietcombank · 970422 MB · 970418 BIDV · 970415 VietinBank · 970407 Techcombank
PAYMENT_BANK_BIN=
PAYMENT_BANK_ACCOUNT_NO=
PAYMENT_BANK_ACCOUNT_NAME=
# Tự xác nhận chuyển khoản qua webhook SePay (sepay.vn): bỏ trống = trưởng KP xác nhận tay.
# Khai báo trên SePay: URL https://<backend>/api/payments/sepay-webhook, xác thực "API Key" = BANK_WEBHOOK_API_KEY.
# Sinh khoá: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
BANK_WEBHOOK_PROVIDER=
BANK_WEBHOOK_API_KEY=


# ---------------------------------------------------------------------
# 3. FRONTEND — chỉ biến có tiền tố VITE_ mới vào code trình duyệt
# ---------------------------------------------------------------------
VITE_APP_NAME=Quản lý dân cư
VITE_API_BASE_URL=/api
# true = các trang nhân khẩu / hộ / tạm trú dùng dữ liệu mẫu
VITE_USE_MOCK=true
# Đăng nhập:  api  = qua backend thật (cần MongoDB + backend đang chạy)
#             demo = tài khoản mẫu ngay trên trình duyệt (src/mocks/demoAuth.ts), không cần backend.
#                    Mật khẩu demo ai cũng đọc được trong JS → KHÔNG dùng với dữ liệu thật.
VITE_AUTH_MODE=api
# Đăng nhập lần đầu / quên mật khẩu:  firebase = OTP SMS qua Firebase;  temp_password = mật khẩu tạm (SMS mock)
VITE_PHONE_AUTH=temp_password
# Cấu hình Web app Firebase (Project settings › Your apps). Lấy từ firebaseConfig — không ghi vào code.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Thu quỹ — tài khoản nhận mặc định để tạo mã VietQR (quỹ chưa có tài khoản riêng). Đặt đủ cả 3 hoặc bỏ trống.
# BIN theo VietQR: 970436 Vietcombank · 970422 MB · 970418 BIDV · 970415 VietinBank · 970407 Techcombank
PAYMENT_BANK_BIN=
PAYMENT_BANK_ACCOUNT_NO=
PAYMENT_BANK_ACCOUNT_NAME=
# Tự xác nhận chuyển khoản qua webhook SePay (sepay.vn): bỏ trống = trưởng KP xác nhận tay.
# Khai báo trên SePay: URL https://<backend>/api/payments/sepay-webhook, xác thực "API Key" = BANK_WEBHOOK_API_KEY.
# Sinh khoá: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
BANK_WEBHOOK_PROVIDER=
BANK_WEBHOOK_API_KEY=
VITE_FIREBASE_APP_ID=


# ---------------------------------------------------------------------
# 4. ĐĂNG NHẬP TẠM THỜI — tài khoản mẫu (npm run db:setup trong backend/)
# ---------------------------------------------------------------------
#   Vai trò             Đăng nhập (SĐT / email)   Mật khẩu
#   Trưởng khu phố      0900000002                SEED_TRUONG_KP_PASSWORD
#   Công an khu vực     0900000003                SEED_CONG_AN_KV_PASSWORD
#   Cư dân              0900000004                SEED_CU_DAN_PASSWORD
# Mật khẩu: ≥ 8 ký tự, có chữ và số. Bỏ trống = tự sinh ngẫu nhiên và in ra một lần.
SEED_TRUONG_KP_PASSWORD=
SEED_CONG_AN_KV_PASSWORD=
SEED_CU_DAN_PASSWORD=

# Tài khoản CHƯA có mật khẩu — thử luồng đăng nhập lần đầu (nhận mật khẩu tạm qua SMS rồi đổi mật khẩu).
# Dạng SĐT:vai_trò[:Họ tên], cách nhau dấu phẩy. Vai trò: truong_kp / cong_an_kv / cu_dan.
# Cư dân được gán làm chủ hộ HK-1002, HK-1003… khi chạy db:setup -- --demo.
# VD: SEED_FIRST_LOGIN=0912345678:truong_kp,0987654321:cu_dan:Nguyễn Văn B
SEED_FIRST_LOGIN=
