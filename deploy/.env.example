# =====================================================================
# Cấu hình backend PRODUCTION trên VPS — sao chép thành deploy/.env (KHÔNG commit, đã nằm trong .gitignore).
#   cp .env.example .env && nano .env
# Chỉ biến của backend; biến VITE_* của frontend đặt trên Vercel (Project → Settings → Environment Variables).
# =====================================================================

# --- Cloudflare Tunnel (Zero Trust → Networks → Tunnels → token của tunnel) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Database (MongoDB Atlas) ---
MONGODB_URI=
MONGODB_DB_NAME=khupho
MONGODB_TIMEOUT_MS=30000

# --- Khoá bí mật: PHẢI giống hệt khoá đã dùng tạo dữ liệu (khác khoá = không đọc được dữ liệu mã hoá) ---
JWT_ACCESS_SECRET=
DATA_ENCRYPTION_KEY=
DATA_INDEX_KEY=

# --- Mạng ---
LOG_LEVEL=info
# Frontend gọi API qua rewrite /api của Vercel → cùng tên miền với frontend.
CORS_ORIGINS=https://khupho.vercel.app
# Trình duyệt → Vercel → Cloudflare → backend: thường là 2 proxy.
# Kiểm tra: mở https://khupho.vercel.app/api/health, "clientIp" phải là IP thật của bạn; nếu ra IP lạ thì tăng lên 3.
# Cloudflare (Tunnel / proxy): IP thật nằm trong header này. Đặt cf-connecting-ip khi chạy sau Cloudflare.
CLIENT_IP_HEADER=cf-connecting-ip
TRUST_PROXY=2
# Cookie chỉ gửi qua HTTPS (mặc định đã bật khi NODE_ENV=production).
COOKIE_SECURE=true

# --- Đăng nhập ---
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT=20
TEMP_PASSWORD_RATE_LIMIT=5
# Chống spam (mỗi IP): mọi API / phút, API ghi dữ liệu / phút; số phiên đăng nhập tối đa mỗi tài khoản
API_RATE_LIMIT=300
WRITE_RATE_LIMIT=30
MAX_SESSIONS_PER_USER=10
# Chống quá tải: kết nối HTTP đồng thời, thời gian tối đa mỗi request (ms), số kết nối tới MongoDB
HTTP_MAX_CONNECTIONS=1000
HTTP_REQUEST_TIMEOUT_MS=30000
MONGODB_MAX_POOL_SIZE=20
BCRYPT_COST=12

# --- Đăng nhập lần đầu: Firebase OTP (mã project trong Firebase Console) ---
FIREBASE_PROJECT_ID=
SMS_PROVIDER=mock
TEMP_PASSWORD_TTL_MINUTES=15
TEMP_PASSWORD_RESEND_SECONDS=60

# --- Thu quỹ: tài khoản nhận + webhook SePay (bỏ trống = trưởng KP xác nhận tay) ---
PAYMENT_BANK_BIN=
PAYMENT_BANK_ACCOUNT_NO=
PAYMENT_BANK_ACCOUNT_NAME=
BANK_WEBHOOK_PROVIDER=
BANK_WEBHOOK_API_KEY=
