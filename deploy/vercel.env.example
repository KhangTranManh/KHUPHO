# Mẫu biến môi trường frontend trên Vercel (Production). Bản có giá trị: frontend/.env.vercel (không commit).
# Vercel → Project → Settings → Environment Variables → dán toàn bộ nội dung vào ô Key (tự tách từng biến)
# hoặc "Import .env". Type: Config (biến VITE_* lộ ra trình duyệt nên KHÔNG được là Secret, KHÔNG đặt bí mật).
# Đổi xong phải Redeploy — biến VITE_* chỉ có hiệu lực khi build lại.

VITE_AUTH_MODE=api
VITE_USE_MOCK=false
VITE_API_BASE_URL=/api
VITE_PHONE_AUTH=firebase
VITE_APP_NAME=Quản lý dân cư
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
